<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="org.atcgroup.mcupdater.client.ui.screen.ErrorScreen">
  <grid id="27dc6" binding="root" layout-manager="GridBagLayout">
    <constraints>
      <xy x="20" y="20" width="838" height="536"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <hspacer id="6af95">
        <constraints>
          <grid row="1" column="1" row-span="3" col-span="1" vsize-policy="1" hsize-policy="6" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
          <gridbag weightx="0.0" weighty="0.0"/>
        </constraints>
      </hspacer>
      <component id="ab0f1" class="javax.swing.JLabel">
        <constraints>
          <grid row="1" column="2" row-span="1" col-span="4" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
          <gridbag weightx="0.0" weighty="0.0"/>
        </constraints>
        <properties>
          <font size="26"/>
          <text value="我们遇到了一些问题 :("/>
        </properties>
      </component>
      <component id="b1be9" class="javax.swing.JLabel" binding="errorMessage">
        <constraints>
          <grid row="2" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
          <gridbag top="5" left="0" bottom="5" right="0" weightx="0.0" weighty="0.0"/>
        </constraints>
        <properties>
          <text value="Label"/>
        </properties>
      </component>
      <vspacer id="e0bec">
        <constraints>
          <grid row="0" column="2" row-span="1" col-span="4" vsize-policy="6" hsize-policy="1" anchor="0" fill="2" indent="0" use-parent-layout="false"/>
          <gridbag weightx="0.0" weighty="0.0"/>
        </constraints>
      </vspacer>
      <component id="8690a" class="org.atcgroup.mcupdater.client.ui.component.ImagePanel" binding="icon">
        <constraints>
          <grid row="0" column="0" row-span="4" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
          <gridbag weightx="0.0" weighty="0.0"/>
        </constraints>
        <properties>
          <maximumSize width="120" height="120"/>
          <minimumSize width="120" height="120"/>
          <preferredSize width="120" height="120"/>
        </properties>
      </component>
      <hspacer id="755e4">
        <constraints>
          <grid row="3" column="2" row-span="1" col-span="1" vsize-policy="1" hsize-policy="6" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
          <gridbag weightx="0.0" weighty="0.0"/>
        </constraints>
      </hspacer>
      <component id="c0925" class="javax.swing.JButton" binding="quitButton">
        <constraints>
          <grid row="4" column="4" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
          <gridbag top="0" left="0" bottom="0" right="8" weightx="0.0" weighty="0.0"/>
        </constraints>
        <properties>
          <maximumSize width="80" height="40"/>
          <minimumSize width="80" height="40"/>
          <preferredSize width="100" height="34"/>
          <text value="退出游戏"/>
        </properties>
      </component>
      <component id="3d966" class="javax.swing.JButton" binding="continueButton">
        <constraints>
          <grid row="4" column="5" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
          <gridbag weightx="0.0" weighty="0.0"/>
        </constraints>
        <properties>
          <maximumSize width="100" height="34"/>
          <minimumSize width="100" height="34"/>
          <preferredSize width="100" height="34"/>
          <text value="继续启动"/>
        </properties>
      </component>
    </children>
  </grid>
</form>
