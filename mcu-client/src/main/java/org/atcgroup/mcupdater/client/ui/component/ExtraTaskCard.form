<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="org.atcgroup.mcupdater.client.ui.component.ExtraTaskCard">
  <grid id="27dc6" binding="root" layout-manager="GridBagLayout">
    <constraints>
      <xy x="20" y="20" width="500" height="44"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <component id="aa8da" class="javax.swing.JProgressBar" binding="progress">
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
          <gridbag top="3" left="10" bottom="10" right="10" weightx="1.0" weighty="0.0"/>
        </constraints>
        <properties/>
      </component>
      <component id="6fba4" class="javax.swing.JLabel" binding="text">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
          <gridbag top="10" left="10" bottom="0" right="0" weightx="0.0" weighty="0.0"/>
        </constraints>
        <properties>
          <text value="Label"/>
        </properties>
      </component>
    </children>
  </grid>
</form>
