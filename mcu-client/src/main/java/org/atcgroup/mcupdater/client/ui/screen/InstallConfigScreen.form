<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="org.atcgroup.mcupdater.client.ui.screen.InstallConfigScreen">
  <grid id="27dc6" binding="root" custom-create="true" layout-manager="GridBagLayout">
    <constraints>
      <xy x="20" y="20" width="828" height="605"/>
