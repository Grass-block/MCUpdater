                  <gridbag weightx="0.0" weighty="0.0"/>
                </constraints>
              </vspacer>
              <component id="70968" class="javax.swing.JButton" binding="confirmButton">
                <constraints>
                  <grid row="5" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                  <gridbag weightx="0.0" weighty="0.0"/>
                </constraints>
                <properties>
                  <maximumSize width="78" height="36"/>
                  <minimumSize width="78" height="36"/>
